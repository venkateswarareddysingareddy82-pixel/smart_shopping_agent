# ============ Smart Shopping Platform - environment variables ============
# Copy this file to ".env" (start.bat does it automatically). NEVER commit .env.

# ---- Database ----
# Leave empty for the built-in SQLite file (backend/smart_shopping.db) - easiest for local use.
# PostgreSQL example: postgresql://user:password@localhost:5432/smart_shopping
DATABASE_URL=

# ---- Security ----
# Any long random string. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---- URLs ----
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Extra allowed CORS origins, comma separated (optional)
CORS_ORIGINS=

# ---- AI assistant (OPTIONAL - the app works fully in demo mode without a key) ----
AI_API_KEY=your_geoogle_api_key_here
# anthropic (default) or openai (any OpenAI-compatible API)
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5-20251001
# Optional custom base URL (e.g. a local OpenAI-compatible server)
AI_BASE_URL=

# ---- Frontend (read by Vite at build time; leave empty in local dev) ----
VITE_API_URL=

# ---- Demo data (development only - change these!) ----
AUTO_SEED=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=User@12345
